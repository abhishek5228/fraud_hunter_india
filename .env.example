# Copy to .env (never commit it) or set these in Render -> Environment. Every line is optional; a feature stays OFF without its variable.
FH_API_KEY=                    # require X-API-Key on scoring endpoints
FH_ORIGINS=https://abhishekisagemai-bot.github.io
RAZORPAY_WEBHOOK_SECRET=       # Razorpay test-mode webhook secret -> POST /api/webhook/razorpay
IPINFO_TOKEN=                  # ipinfo.io token -> real IP to city + VPN/data-centre detection
TELEGRAM_BOT_TOKEN=            # from @BotFather
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
FH_ALERT_MIN_AMT=0             # only alert at or above this many rupees
FH_ALERT_PER_MIN=20            # alert rate limit
FH_CONSORTIUM_KEY=             # shared secret among member banks (mule-hash sharing)
ANTHROPIC_API_KEY=             # optional: lets the analyst copilot reword briefs (facts only)
RAZORPAY_KEY_ID=               # optional: lets Scam Shield look up who a UPI handle is registered to
RAZORPAY_KEY_SECRET=
FH_PSI_PEERS=                  # comma-separated base URLs of partner banks allowed for private set intersection
FH_PSI_PEER_KEY=               # API key to present to those peers
FH_PSI_SECRET=                 # optional hex secret; otherwise generated once and kept in artifacts/psi.key (0600)
